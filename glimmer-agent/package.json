{
  "name": "glimmer-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": { "types": "./dist/*.d.ts", "default": "./dist/*.js" }
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test:package": "node scripts/check-package.mjs",
    "test": "node --test --test-reporter=tap \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "verify:vendor": "node scripts/verify-vendor.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
