{
  "name": "nomos-muse-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": "24.22.1"},
  "overrides": {"undici": "6.29.1"},
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "test:runtime": "node --test tests/runtime.test.mjs",
    "precheck": "node scripts/check-runtime.mjs",
    "test:mojo": "node scripts/mojo-tests.mjs integration",
    "test:mojo-sandbox": "node scripts/mojo-tests.mjs sandbox",
    "test:mojo-ui": "node scripts/mojo-browser.mjs",
    "test:file-tools": "node scripts/filetool-tests.mjs integration",
    "test:file-sandbox": "node scripts/filetool-tests.mjs sandbox",
    "test:file-ui": "node scripts/filetool-browser.mjs",
    "test:profiles": "node scripts/profile-tests.mjs runtime",
    "test:generation": "node --test --test-reporter=tap tests/generation/*.test.ts",
    "test:generation-ui": "node scripts/generation-browser.mjs",
    "test:profile-import": "node scripts/profile-tests.mjs import",
    "test:profile-ui": "node scripts/profile-browser.mjs",
    "dev": "vite dev --host 127.0.0.1 --port 5226 --strictPort",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --output human",
    "build": "vite build",
    "start": "sh scripts/start.sh",
    "refresh:preview": "node scripts/refresh-preview.mjs --start-if-stopped",
    "verify": "node scripts/verify.mjs",
    "test:contract": "node --test tests/contract.test.mjs",
    "test:browser": "node scripts/browser.mjs",
    "test:ui": "node scripts/ui.mjs",
    "test:contrast": "node scripts/contrast.mjs",
    "test:live": "node scripts/browser.mjs --live",
    "test:transport": "node scripts/transport.mjs",
    "test:chat": "node scripts/live-browser.mjs",
    "test:meta": "node --test --test-reporter=tap tests/meta/*.test.ts && node scripts/meta-browser.mjs",
    "test:kernel": "node scripts/live-e2e.mjs",
    "test:steering": "node scripts/steering-tests.mjs",
    "test:integration": "node scripts/lab-integration.mjs && npm run test:browser && npm run test:ui && npm run test:contrast",
    "test:start": "node scripts/start-check.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@nomos/svelte-ai-elements": "file:vendor/nomos-svelte-ai-elements-0.1.0.tgz",
    "@nomos/svelte-fancy": "file:vendor/nomos-svelte-fancy-0.1.0.tgz",
    "@nomos/svelte-magic": "file:vendor/nomos-svelte-magic-0.1.0.tgz",
    "bits-ui": "2.19.5",
    "glimmer-agent": "file:vendor/glimmer-agent-a84c710.tgz",
    "phosphor-svelte": "3.0.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.0.0",
    "playwright": "1.58.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  }
}
