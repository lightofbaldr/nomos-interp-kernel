# Harness² settings. Shell variables override these. See docs/SETUP.md and docs/PI.md.

# ---- executor: what runs the benchmark task ----------------------------------------
# provider/model in the executor's own syntax; OpenCode and Pi both use provider/model.
HARNESS2_SOLVER_MODEL=zai/glm-5.3-flash

# Pi substrate (--substrate pi)
HARNESS2_PI_THINKING=high                 # off | minimal | low | medium | high | xhigh | max
HARNESS2_PI_TOOLS=+grep,+find,+ls         # additive form keeps extension-registered tools; a plain allowlist drops them
HARNESS2_PI_BIN=pi
HARNESS2_PI_CONCURRENCY=2                 # concurrent Pi rollouts, process-wide
#HARNESS2_PI_PASS_ENV=ZAI_API_KEY         # extra variables passed into rollouts (keys normally come from the linked models.json)
#HARNESS2_PI_MODELS_JSON=/home/you/.pi/agent/models.json   # what dependencies/pi/agent/models.json links to
#HARNESS2_PI_AUTH_JSON=/home/you/.pi/agent/auth.json

# ---- improver: proposer, composer, selector, reflector -----------------------------
HARNESS2_IMPROVER_CHANNEL=claude_cli      # claude_cli | codex_cli | opencode
HARNESS2_IMPROVER_MODEL=opus              # bare id or alias for the CLI channels; provider/model for opencode
HARNESS2_IMPROVER_EFFORT=high
HARNESS2_CLAUDE_USE_VERTEX=0              # 1 restores the Vertex environment for claude_cli
HARNESS2_CLAUDE_ISOLATION=flags           # flags (works with the login) | bare (API-key users only)
# Mojo improver only: off = original trusted host process, not a sandbox fallback.
# api-key uses operator ANTHROPIC_API_KEY, injected by the host broker, and --bare.
# subscription uses operator CLAUDE_CODE_OAUTH_TOKEN from claude setup-token, no --bare;
# its live route remains code-held over tool-visible token exposure. No saved-login reader.
HARNESS2_MOJO_IMPROVER_AUTH=off           # off | api-key | subscription; see docs/IMPROVER-SANDBOX.md
HARNESS2_LIMIT_MAX_WAIT=7200              # seconds to wait out a plan usage limit before the stage falls back
HARNESS2_STOP_ON_LIMIT=0                  # 1 stops the sweep cleanly instead; re-run the same command to resume

# ---- judge -------------------------------------------------------------------------
# cli/claude:<model> and cli/codex:<model> are served by harness2-judge-bridge: start it and
# copy the BASE_URL and API_KEY lines it prints. Vertex judges work as upstream documents.
HARNESS2_JUDGE_MODEL=cli/claude:sonnet      # cli/codex:<model> works too, but the ChatGPT plan rate-limits parallel calls: use HARNESS2_JUDGE_WORKERS=1
HARNESS2_JUDGE_BASE_URL=
HARNESS2_JUDGE_API_KEY=
HARNESS2_JUDGE_EFFORT=low
HARNESS2_JUDGE_WORKERS=6                  # JobBench judge threads; keep at or below the bridge's --concurrency (1 for a Codex judge)
HARNESS2_JUDGE_RUBRIC_TIMEOUT=600         # seconds per rubric call before the judge retries it
HARNESS2_JUDGE_TIMEOUT=3600               # seconds for one task's whole judge run

# ---- Google Cloud: OpenCode/Codex executors, Vertex improver and judges ------------
#GOOGLE_CLOUD_PROJECT=
#GOOGLE_CLOUD_LOCATION=global
#HARNESS2_CODEX_BASE_URL=
#HARNESS2_CODEX_API_KEY=
#HARNESS2_CODEX_MODEL=

# ---- output ------------------------------------------------------------------------
#HARNESS2_RUNS_DIR=runs
