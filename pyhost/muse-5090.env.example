# Muse-Glimmer-30B on one 24 GB discrete Blackwell GPU (sm_120): the settings our RTX 5090 laptop GPU serves with.
#   NOMOS_HOST_ENV=pyhost/muse-5090.env.example pyhost/serve_nomos.sh --model muse up
# `--model muse` takes the .so, weights and tokenizer paths from pyhost/models.py; this file sets the rest.
# Check what `up` would run with, without starting anything: the same command with `env` instead of `up`.

# Loopback only. Without NOMOS_HOST the launcher binds every interface, and the serve has no authentication.
export NOMOS_HOST=127.0.0.1 NOMOS_PORT=8091 CUDA_VISIBLE_DEVICES=0

# NVFP4 weights, W4A4, 16-bit precision.
export NOMOS_WEIGHT_NVFP4=1 NOMOS_W4A4=1 NOMOS_PRECISION_BITS=16

# KV cache: quantized, not INT4; no sliding-window variant.
export NOMOS_KV_QUANT=1 NOMOS_KV_INT4=0 NOMOS_KV_I4_BLOCK=32 NOMOS_KV_SWA=0

# A 32K context, with batched, chunked prefill.
export NOMOS_MAX_SEQ=32768 NOMOS_BATCHED_PREFILL=1 NOMOS_PREFILL_CHUNK=256

# DFlash speculative decoding with the Q4 assistant (tools/convert_muse_assistant_q4.py). Without it, set
# NOMOS_SERVE_SPEC=0.
export NOMOS_SERVE_SPEC=1 SPEC_VB=8 DFLASH_DIR="$HOME/nomos_data/muse-assistant-flat-q4"

# The KV session store (prefix reuse across requests) and its RAM and disk budgets.
export NOMOS_KVSTORE=1 NOMOS_KVSTORE_DIR="$HOME/nomos_data/kvstore" NOMOS_KVSTORE_RAM_GB=8 NOMOS_KVSTORE_DISK_GB=100
export NOMOS_KVSTORE_MIN_REUSE=16 NOMOS_KVSTORE_MIN_SWITCH=256

export CUBLAS_WORKSPACE_CONFIG=:4096:8
